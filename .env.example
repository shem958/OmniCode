# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dev_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set to 'local' to run Qdrant in-memory/local file mode without needing docker
QDRANT_MODE=local 

# Redis & NATS Configurations
REDIS_HOST=localhost
REDIS_PORT=6379
NATS_URL=nats://localhost:4222

# Service Ports
GATEWAY_PORT=8080
REPO_SERVICE_PORT=8081
SEARCH_SERVICE_PORT=8082
USER_SERVICE_PORT=8083
AI_ENGINE_PORT=8000
FRONTEND_PORT=3000
